# Nepal Opportunity Map environment variables
# Copy this file to .env.local for local overrides.

# Keep this empty for local development. Vite proxies API calls to FastAPI at
# http://127.0.0.1:8000. Set a deployed API origin in staging/production.
VITE_API_BASE_URL=

# MapLibre/Leaflet tile and style URLs
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# App environment and feature flags
VITE_APP_ENV=development
VITE_ENABLE_AI_RECOMMENDATIONS=true

# Observability (leave empty to disable)
VITE_SENTRY_DSN=
VITE_GOOGLE_ANALYTICS_ID=
