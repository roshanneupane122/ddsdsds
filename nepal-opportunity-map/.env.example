# ============================================================
# Nepal Opportunity Map — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ============================================================

# Backend API base URL (FastAPI + PostGIS)
# All service calls in src/services/ use this as the root.
VITE_API_BASE_URL=https://api.nepalopportunitymap.gov.np/v1

# MapLibre tile/style URLs
# Swap these for a licensed tile server without touching any component code.
# OSM raster tiles work as a free default during development.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# App environment — controls MSW mock activation and dev tooling
# Values: development | staging | production
VITE_APP_ENV=development

# Feature flags
VITE_ENABLE_AI_RECOMMENDATIONS=true

# Observability (leave empty to disable)
VITE_SENTRY_DSN=
VITE_GOOGLE_ANALYTICS_ID=

# NOTE (PDF Export): Reports currently use client-side jsPDF + html2canvas.
# This should be replaced with a server-side PDF generation endpoint once the
# backend is ready, as client-side rendering produces lower-fidelity output
# for complex maps and charts.
